# Copy to .env (git-ignored). Server-side only: never commit, log, or ship to the browser.

# Nace Drex key (format: nace_sk_...). Required for decisions to be labeled DREX: LIVE.
NACE_API_KEY=
NACE_DEFAULT_DECISION_MODEL=drex-latest

# Meta model API key (optional LLM comparison provider). LLAMA_API_KEY is accepted as an alias.
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

PORT=3001
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=./data/vice-exchange.sqlite
GAME_TICK_HZ=10
NPC_DECISION_CONCURRENCY=4
MAX_DECISION_CALLS_PER_MIN=30

# Protects demo.reset / demo.incident / mode switches. Empty = demo-director commands disabled.
DEMO_DIRECTOR_SECRET=
